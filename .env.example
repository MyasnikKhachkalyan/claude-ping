# Working in a checkout? Copy to .env. Otherwise prefer ~/.claude-ping/config.json — a plugin
# update replaces this directory, and that file survives. The /claude-ping skill writes it for
# you; `node dist/src/setup.js status` shows what's configured. Env vars win over the file.

# Talk to @BotFather in Telegram -> /newbot -> paste the token here
TELEGRAM_BOT_TOKEN=

# Message your new bot once, then run `node dist/src/setup.js detect`
TELEGRAM_CHAT_ID=

# --- Tier 1: pings ---
# Seconds Claude may sit waiting on you before you get pushed (0 = ping the instant a turn
# ends). This is your idle time, not how long the turn took to run.
# CLAUDE_PING_WAIT_SECONDS=10
# CLAUDE_PING_NOTIFY_STOP=1
# CLAUDE_PING_NOTIFY_PERMISSION=1

# --- Tier 2: bridge ---
# The project Claude should work in (defaults to where you launch the bridge)
# CLAUDE_PING_CWD=/Users/you/Desktop/some-project
# CLAUDE_PING_MODEL=claude-sonnet-5
# CLAUDE_PING_PERMISSION_MODE=default
# CLAUDE_PING_VERBOSE=0
